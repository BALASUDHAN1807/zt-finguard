{
  // GitHub Codespaces: a cloud machine with Docker that builds and runs the whole
  // ZT-FinGuard stack automatically. Open the "Ports" tab for the dashboard link.
  "name": "ZT-FinGuard",
  // GitHub's default Codespaces image: Docker (docker-in-docker) and Python are
  // preinstalled and cached on Codespaces hosts, so start-up is fast and no
  // dev-container "feature" has to be built.
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "hostRequirements": { "cpus": 2, "memory": "8gb", "storage": "32gb" },
  "postStartCommand": "bash .devcontainer/start.sh",
  "forwardPorts": [8501, 8443],
  "portsAttributes": {
    "8501": { "label": "ZT-FinGuard dashboard", "protocol": "https", "onAutoForward": "openBrowser" },
    "8443": { "label": "API gateway", "protocol": "https", "onAutoForward": "silent" }
  },
  "otherPortsAttributes": { "onAutoForward": "ignore" },
  "customizations": {
    "codespaces": { "openFiles": ["docs/codespaces.md"] }
  }
}
